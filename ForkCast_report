weight * expanded_df['cost_score'] + \n                                   rating_weight * expanded_df['rating_score'] + \n                                   booking_weight * expanded_df['booking_score'] + \n                                   online_weight * expanded_df['online_score'])\n    \n    best_value = expanded_df.sort_values(['score', 'avg_cost'], ascending=[False, True])\n\n    result = best_value[['name','address', 'rate', 'avg_cost', 'online_order', 'book_table', 'cuisines', 'score']]\n    \n    return result.head(10)\n\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-31T10:49:23.701915Z","iopub.execute_input":"2025-03-31T10:49:23.702333Z","iopub.status.idle":"2025-03-31T10:49:23.713395Z","shell.execute_reply.started":"2025-03-31T10:49:23.702300Z","shell.execute_reply":"2025-03-31T10:49:23.711553Z"}},"outputs":[],"execution_count":150},{"id":"fae9f4ef-82dc-4d4b-9e99-7ac50e07c998","cell_type":"code","source":"## sample function call \n#best_value_restaurants('BTM', 'Casual Dining', max_cost=1000, rating_range=(3.9, 4.2),  cost_weight=0.5, rating_weight=0.4, booking_weight=0.05, online_weight=0.05)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-31T10:49:25.366175Z","iopub.execute_input":"2025-03-31T10:49:25.366537Z","iopub.status.idle":"2025-03-31T10:49:25.370585Z","shell.execute_reply.started":"2025-03-31T10:49:25.366512Z","shell.execute_reply":"2025-03-31T10:49:25.369362Z"}},"outputs":[],"execution_count":151},{"id":"7e8e04ee-125a-42c2-9cc2-1c1d11fd28bc","cell_type":"code","source":"# Here you can select:\n# city\n# rest type\n# max cost and rating range\n# then on  the basis of your flexibilty of cost , rating , online facility ,  booking table facility you can get the best fit restaurants \n# weights determine importance of that factor","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-03-31T10:49:25.966505Z","iopub.execute_input":"2025-03-31T10:49:25.966921Z","iopub.status.idle":"2025-03-31T